{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@interfaces/*": ["../../web/interfaces/*"],
      "@hooks/*": ["./src/hooks/*"],
      "@common/*": ["./common/*"],
      "@components/*": ["./src/components/*"],
      "@libs/*": ["../../web/libs/*"],
      "@pages/*": ["./src/pages/*"],
      "@package-utils/*": ["./src/utils/*"],
      "@web-utils/*": ["../../web/utils/*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts"
  ],
  "exclude": ["node_modules"]
}
